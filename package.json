{
  "name": "dsh-memory-center",
  "version": "0.10.11",
  "private": true,
  "description": "用户可查看、编辑、分组、导入导出、逐会话决定是否加载、并可自行选择同步到 Git/WebDAV 的本地长期记忆库（DSH 插件）",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "LornBerry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LornBerry/dsh-memory-center.git"
  },
  "homepage": "https://github.com/LornBerry/dsh-memory-center#readme",
  "bugs": {
    "url": "https://github.com/LornBerry/dsh-memory-center/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "long-term-memory",
    "sync",
    "记忆"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node dev/run-all.mjs",
    "doctor": "node dev/doctor.mjs",
    "release": "node dev/release.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/paths.js",
    "lib/retrieval.js",
    "lib/sync.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "lib/anchor.js",
    "lib/topics.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
